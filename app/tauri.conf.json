{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-rzr",
  "version": "0.6.14",
  "identifier": "io.github.aspidovss.openrzr",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Razer mouse settings without cloud or accounts",
    "category": "Utility",
    "licenseFile": "../packaging/windows/agreement.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "../packaging/windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/99-open-rzr.rules": "../packaging/linux/99-open-rzr.rules"
        }
      }
    }
  }
}
