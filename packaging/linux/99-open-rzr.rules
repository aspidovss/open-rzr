# open-rzr: access to Razer mouse HID control for the logged-in user;
# input lines: read the mouse's own key events (F13-F24 triggers of macro program actions)
# Razer Orochi 2011
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0013", TAG+="uaccess"
KERNEL=="event*", SUBSYSTEM=="input", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0013", TAG+="uaccess"
